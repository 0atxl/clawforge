{
  "name": "clawforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ClawForge — Wafer-Scale Interactive 3D CAD Studio & Live Cerebras vs. GPU Comparison Arena",
  "scripts": {
    "dev": "vite",
