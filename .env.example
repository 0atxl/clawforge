# =============================================================================
# ClawForge — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env!
# =============================================================================

# Server port (serves both built Studio UI and API/SSE endpoints)
PORT=3000
HOST=127.0.0.1

# Allowed browser origin for Vercel frontend -> VM backend CORS (use * or your Vercel URL)
CORS_ORIGIN=*

# Primary LLM backend mode:
#   openclaw        -> Standard OpenClaw Gateway (/v1/chat/completions)
#   cerebras-direct -> Direct Cerebras API (https://api.cerebras.ai/v1)
#   demo            -> Offline local presets + mock streaming (0 API calls)
CLAWFORGE_BACKEND=openclaw

# Standard OpenClaw Gateway (e.g. on VM at 127.0.0.1:18789)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_CAD_AGENT_ID=clawforge
OPENCLAW_SHOPPER_AGENT_ID=clawforge-shopper

# Cerebras API (used by telemetry proxy OR cerebras-direct mode)
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=moonshotai-kimi-k3.1-pro-trial
CEREBRAS_REASONING_EFFORT=low
CEREBRAS_MAX_TOKENS_DRAFT=6144
# Endpoint etiquette: strictly 0 automatic retries on 429/timeout (no retry storms!)
LLM_MAX_RETRIES=0

# Optional Transparent Cerebras Telemetry Proxy (captures exact server time_info & cached_tokens
# while keeping standard unpatched OpenClaw as the agent harness)
TELEMETRY_PROXY_PORT=18799
TELEMETRY_PROXY_ENABLED=true

# Optional Live GPU Provider for Side-by-Side Race Comparison
GPU_PROVIDER_NAME=NVIDIA NIM GPU
GPU_API_KEY=
GPU_BASE_URL=https://integrate.api.nvidia.com/v1
GPU_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Frontend (Vercel build environment variable, optional locally):
# VITE_API_BASE=https://your-vm-backend.example.com
